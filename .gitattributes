# Enforce CRLF line endings for all text files (Windows codebase)
* text=auto eol=crlf

# Specific file types
*.cpp text eol=crlf
*.h text eol=crlf
*.c text eol=crlf
*.hpp text eol=crlf
*.rc text eol=crlf
*.xml text eol=crlf
*.lua text eol=crlf
*.cfg text eol=crlf
*.ps1 text eol=crlf
*.bat text eol=crlf
*.md text eol=crlf
*.txt text eol=crlf

# Legacy game data text is UTF-16LE; CRLF normalization corrupts the byte pairs.
Data/**/*.txt -text -eol
Sources/src/data/**/*.txt -text -eol

# Visual Studio project files
*.sln text eol=crlf
*.vcxproj text eol=crlf
*.vcxproj.filters text eol=crlf
*.props text eol=crlf
*.targets text eol=crlf
*.dsp text eol=crlf
*.dsw text eol=crlf

# Binary files - never touch these
*.dll binary
*.lib binary
*.exe binary
*.pak binary
*.obj binary
*.pdb binary
*.bmp binary
*.png binary
*.jpg binary
*.jpeg binary
*.tga binary
*.dds binary
*.bik binary -eol
*.chm binary
*.upd binary
*.reg binary
*.7z binary
*.7z.* binary
*.zip binary
*.ZIP binary
*.zst binary
*.tar binary
*.gz binary
