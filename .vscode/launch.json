{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Game.exe (Zig, x86)",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${workspaceFolder}/zig-out/game-x86-debug/Game.exe",
      "args": [],
