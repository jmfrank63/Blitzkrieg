      "preLaunchTask": "Zig Build Game (Debug, x86)",
      "symbolOptions": {
        "searchPaths": [
          "${workspaceFolder}/zig-out/game-x86-debug",
          "${workspaceFolder}/zig-out/bin"
        ],
        "searchMicrosoftSymbolServer": false,
        "cachePath": "${workspaceFolder}/.vscode/symbolcache"
      },
      "sourceFileMap": {},
      "logging": {
        "moduleLoad": false,
        "trace": false,
        "engineLogging": false,
        "programOutput": true,
        "exceptions": true
      }
    },
