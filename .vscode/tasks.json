        "/p:Configuration=Release",
        "/p:Platform=Win32",
        "/m",
        "/v:minimal"
      ],
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "Build StreamIO (Debug)",
      "type": "shell",
      "command": "msbuild",
      "args": [
        "${workspaceFolder}/Sources/src/StreamIO/StreamIO.vcxproj",
