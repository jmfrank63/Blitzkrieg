{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build Game (Debug)",
      "type": "shell",
      "command": "msbuild",
      "args": [
        "${workspaceFolder}/Sources/src/A7.sln",
        "/t:Game",
        "/p:Configuration=Debug",
        "/p:Platform=Win32",
        "/m",
        "/v:minimal"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": "$msCompile"
    },
