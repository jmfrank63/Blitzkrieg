{
  "version": "2.0.0",
  "options": {
    "shell": {
      "executable": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy", "Bypass",
        "-Command",
        "& 'C:\\Program Files\\Microsoft Visual Studio\\18\\Insiders\\Common7\\Tools\\Launch-VsDevShell.ps1' -Arch x86; "
      ]
    }
  },
  "tasks": [
    {
      "label": "Build Game (Debug)",
      "type": "shell",
      "command": "msbuild",
      "args": [
        "${workspaceFolder}/Sources/src/A7.sln",
        "/t:Game",
        "/p:Configuration=Debug",
        "/p:Platform=Win32",
        "/m",
        "/v:minimal"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "Build Game (Release)",
      "type": "shell",
      "command": "msbuild",
      "args": [
        "${workspaceFolder}/Sources/src/A7.sln",
        "/t:Game",
        "/p:Configuration=Release",
        "/p:Platform=Win32",
        "/m",
        "/v:minimal"
      ],
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "Build StreamIO (Debug)",
      "type": "shell",
      "command": "msbuild",
      "args": [
        "${workspaceFolder}/Sources/src/StreamIO/StreamIO.vcxproj",
        "/p:Configuration=Debug",
        "/p:Platform=Win32",
        "/m:1",
        "/v:minimal"
      ],
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "Build ELK Editor (Debug)",
      "type": "shell",
      "command": "msbuild",
      "dependsOn": "Build StreamIO (Debug)",
      "dependsOrder": "sequence",
      "args": [
        "${workspaceFolder}/Sources/src/ELK/ELK.vcxproj",
        "/p:Configuration=Debug",
        "/p:Platform=Win32",
        "/m:1",
        "/v:minimal"
      ],
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "Rebuild ELK Editor (Debug)",
      "type": "shell",
      "command": "msbuild",
      "dependsOn": "Build StreamIO (Debug)",
      "dependsOrder": "sequence",
      "args": [
        "${workspaceFolder}/Sources/src/ELK/ELK.vcxproj",
        "/t:Rebuild",
        "/p:Configuration=Debug",
        "/p:Platform=Win32",
        "/m:1",
        "/v:minimal"
      ],
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "Build Object Editor (Debug)",
      "type": "shell",
      "command": "msbuild",
      "dependsOn": "Build StreamIO (Debug)",
      "dependsOrder": "sequence",
      "args": [
        "${workspaceFolder}/Sources/src/editor/editor.vcxproj",
        "/p:Configuration=Debug",
        "/p:Platform=Win32",
        "/m:1",
        "/v:minimal"
      ],
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "Build MapEditor (Debug)",
      "type": "shell",
      "command": "msbuild",
      "dependsOn": "Build StreamIO (Debug)",
      "dependsOrder": "sequence",
      "args": [
        "${workspaceFolder}/Sources/src/MapEditor/MapEditor.vcxproj",
        "/p:Configuration=Debug",
        "/p:Platform=Win32",
        "/m:1",
        "/v:minimal"
      ],
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "Build All (Debug)",
      "type": "shell",
      "command": "msbuild",
      "args": [
        "${workspaceFolder}/Sources/src/A7.sln",
        "/p:Configuration=Debug",
        "/p:Platform=Win32",
        "/m",
        "/v:minimal"
      ],
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "Build All (Release)",
      "type": "shell",
      "command": "msbuild",
      "args": [
        "${workspaceFolder}/Sources/src/A7.sln",
        "/p:Configuration=Release",
        "/p:Platform=Win32",
        "/m",
        "/v:minimal"
      ],
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "Rebuild Game (Debug)",
      "type": "shell",
      "command": "msbuild",
      "args": [
        "${workspaceFolder}/Sources/src/A7.sln",
        "/t:Game:Rebuild",
        "/p:Configuration=Debug",
        "/p:Platform=Win32",
        "/m",
        "/v:minimal"
      ],
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "Clean All",
      "type": "shell",
      "command": "msbuild",
      "args": [
        "${workspaceFolder}/Sources/src/A7.sln",
        "/t:Clean",
        "/p:Configuration=Debug",
        "/p:Platform=Win32"
      ],
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Build Game (FastDebug)",
      "type": "shell",
      "command": "msbuild",
      "args": [
        "${workspaceFolder}/Sources/src/A7.sln",
        "/t:Game",
        "/p:Configuration=FastDebug",
        "/p:Platform=Win32",
        "/m",
        "/v:minimal"
      ],
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "Zig Build Game (Debug, x64)",
      "type": "process",
      "command": "zig",
      "args": [
        "build",
        "--build-file",
        "${workspaceFolder}/build.zig",
        "install-game",
        "-Dtarget=x86_64-windows-msvc"
      ],
      "group": {
        "kind": "build",
        "isDefault": false
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Zig Build Game (Debug, x64, UBSan Trap)",
      "type": "process",
      "command": "zig",
      "args": [
        "build",
        "--build-file",
        "${workspaceFolder}/build.zig",
        "install-game",
        "-Dtarget=x86_64-windows-msvc",
        "-Dubsan-trap=true"
      ],
      "group": {
        "kind": "build",
        "isDefault": false
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Zig Build Game (Release, x64)",
      "type": "process",
      "command": "zig",
      "args": [
        "build",
        "--build-file",
        "${workspaceFolder}/build.zig",
        "install-game",
        "-Dtarget=x86_64-windows-msvc",
        "--release=fast"
      ],
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Zig Run Game (Debug, x64)",
      "type": "process",
      "command": "${workspaceFolder}/zig-out/game/windows/x86_64/debug/Game.exe",
      "options": {
        "cwd": "${workspaceFolder}/zig-out/game/windows/x86_64/debug"
      },
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    }
  ]
}
