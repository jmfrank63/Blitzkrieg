{
  "version": "2.0.0",
  "options": {
    "shell": {
      "executable": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy", "Bypass",
        "-Command",
        "& 'C:\\Program Files\\Microsoft Visual Studio\\18\\Insiders\\Common7\\Tools\\Launch-VsDevShell.ps1' -Arch x86; "
      ]
    }
  },
  "tasks": [
    {
      "label": "Build Game (Debug)",
      "type": "shell",
      "command": "msbuild",
      "args": [
        "${workspaceFolder}/Sources/src/A7.sln",
        "/t:Game",
        "/p:Configuration=Debug",
        "/p:Platform=Win32",
        "/m",
        "/v:minimal"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "Build Game (Release)",
      "type": "shell",
      "command": "msbuild",
      "args": [
        "${workspaceFolder}/Sources/src/A7.sln",
