// Game version VERSIONINFO resource. Bump the version number in build.zig
// (game_version constant) — this file is kept in sync as a convenience for
// manual builds and as a fallback if the generated rc has issues.
#include <winres.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 2,0,0,0
 PRODUCTVERSION 2,0,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "NIVAL Interactive"
            VALUE "FileDescription", "Game"
            VALUE "FileVersion", "2.0.0.0"
            VALUE "InternalName", "Game"
            VALUE "LegalCopyright", "Copyright (c) 2002"
            VALUE "OriginalFilename", "Game.exe"
            VALUE "ProductName", "Blitzkrieg"
            VALUE "ProductVersion", "2.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END