<?xml version="1.0" encoding="utf-8"?>
<Project>
  <PropertyGroup Condition="'$(MSBuildProjectExtension)'=='.vcxproj'">
	<VCProjectVersion Condition="'$(VCProjectVersion)'==''">$(VisualStudioVersion)</VCProjectVersion>
	<PlatformToolset Condition="'$(PlatformToolset)'=='' and '$(DefaultPlatformToolset)'!=''">$(DefaultPlatformToolset)</PlatformToolset>
  </PropertyGroup>
  <ItemDefinitionGroup Condition="'$(MSBuildProjectExtension)'=='.vcxproj'">
	<ClCompile>
	  <PreprocessorDefinitions>WINVER=0x0A00;_WIN32_WINNT=0x0A00;NTDDI_VERSION=0x0A000000;_WINSOCK_DEPRECATED_NO_WARNINGS;%(PreprocessorDefinitions)</PreprocessorDefinitions>
	  <DisableSpecificWarnings>4996;%(DisableSpecificWarnings)</DisableSpecificWarnings>
	</ClCompile>
	<ResourceCompile>
	  <PreprocessorDefinitions>WINVER=0x0A00;_WIN32_WINNT=0x0A00;NTDDI_VERSION=0x0A000000;%(PreprocessorDefinitions)</PreprocessorDefinitions>
	</ResourceCompile>
	<Midl>
	  <PreprocessorDefinitions>WINVER=0x0A00;_WIN32_WINNT=0x0A00;NTDDI_VERSION=0x0A000000;%(PreprocessorDefinitions)</PreprocessorDefinitions>
	</Midl>
  </ItemDefinitionGroup>
</Project>
