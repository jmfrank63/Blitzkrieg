; 32-bit export list. Every entry point is callconv(.c), which on x86 Windows
; is cdecl and so carries a leading underscore that x86_64 does not have; the
; aliases below are the whole reason this file is separate from the x64 one.
; No supported triple is x86 today, so this list is a contract kept in step
; with its sibling rather than something the build exercises.
LIBRARY "CloudSync"
EXPORTS
    bk_cloudsync_available = _bk_cloudsync_available @1
    bk_cloudsync_discovery_status = _bk_cloudsync_discovery_status @2
    bk_cloudsync_refresh_discovery = _bk_cloudsync_refresh_discovery @3
    bk_cloudsync_shutdown = _bk_cloudsync_shutdown @4
    bk_cloudsync_last_error = _bk_cloudsync_last_error @5
    bk_cloudsync_begin = _bk_cloudsync_begin @6
    bk_cloudsync_poll = _bk_cloudsync_poll @7
    bk_cloudsync_outcome = _bk_cloudsync_outcome @8
    bk_cloudsync_error = _bk_cloudsync_error @9
    bk_cloudsync_cancel = _bk_cloudsync_cancel @10
    bk_cloudsync_release = _bk_cloudsync_release @11
    bk_cloudsync_creds_load = _bk_cloudsync_creds_load @12
    bk_cloudsync_creds_save = _bk_cloudsync_creds_save @13
    bk_cloudsync_creds_clear_secret = _bk_cloudsync_creds_clear_secret @14
    bk_cloudsync_creds_present = _bk_cloudsync_creds_present @15
    bk_cloudsync_test_connection = _bk_cloudsync_test_connection @16
    bk_cloudsync_backup_list = _bk_cloudsync_backup_list @17
    bk_cloudsync_backup_entry = _bk_cloudsync_backup_entry @18
    bk_cloudsync_backup_restore = _bk_cloudsync_backup_restore @19
    bk_cloudsync_apply_pending_restore = _bk_cloudsync_apply_pending_restore @20
    bk_cloudsync_restore_undo = _bk_cloudsync_restore_undo @21
    bk_cloudsync_restore_undo_available = _bk_cloudsync_restore_undo_available @22
    bk_cloudsync_creds_fingerprint = _bk_cloudsync_creds_fingerprint @23
    bk_cloudsync_creds_clear_option = _bk_cloudsync_creds_clear_option @24
    bk_cloudsync_catalogue_ensure = _bk_cloudsync_catalogue_ensure @25
    bk_cloudsync_catalogue_providers = _bk_cloudsync_catalogue_providers @26
    bk_cloudsync_catalogue_options = _bk_cloudsync_catalogue_options @27
    bk_cloudsync_catalogue_form = _bk_cloudsync_catalogue_form @28
    bk_cloudsync_catalogue_destinations = _bk_cloudsync_catalogue_destinations @29
    bk_cloudsync_error_detail = _bk_cloudsync_error_detail @30
    bk_cloudsync_config_begin = _bk_cloudsync_config_begin @31
    bk_cloudsync_config_question = _bk_cloudsync_config_question @32
    bk_cloudsync_config_answer = _bk_cloudsync_config_answer @33
