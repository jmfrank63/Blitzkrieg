<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
	<BlitzkriegGameOutputDir>$(MSBuildThisFileDirectory)Game\$(Configuration)\</BlitzkriegGameOutputDir>
	<BlitzkriegGamePdbPath>$(BlitzkriegGameOutputDir)$(TargetName).pdb</BlitzkriegGamePdbPath>
	<BlitzkriegDataSourceDir>$(MSBuildThisFileDirectory)..\..\Data</BlitzkriegDataSourceDir>
	<BlitzkriegDataRelativeSourceDir>..\..\..\..\Data</BlitzkriegDataRelativeSourceDir>
	<BlitzkriegGameDataLink>$(BlitzkriegGameOutputDir)Data</BlitzkriegGameDataLink>
  </PropertyGroup>

  <ItemGroup Condition="'$(MSBuildProjectName)' == 'Game'">
	<BlitzkriegRuntimeDll Include="$(MSBuildThisFileDirectory)**\$(Configuration)\*.dll"
						  Exclude="$(BlitzkriegGameOutputDir)*.dll;$(MSBuildThisFileDirectory)bin\**\*;$(MSBuildThisFileDirectory)Game\**\*" />
  </ItemGroup>

  <!-- Build list of PDB files that correspond to the DLL files being copied (only copy PDB files for DLLs, not for EXEs) -->
  <Target Name="BlitzkriegBuildPdbList" 
		  BeforeTargets="BlitzkriegCopyExistingRuntimeToGameOutput"
		  Condition="'$(MSBuildProjectName)' == 'Game'">
	<ItemGroup>
	  <BlitzkriegRuntimePdb Include="@(BlitzkriegRuntimeDll->'%(RootDir)%(Directory)%(Filename).pdb')" 
							Condition="Exists('%(RootDir)%(Directory)%(Filename).pdb')" />
	</ItemGroup>
  </Target>

	<PropertyGroup Condition="'$(MSBuildProjectName)' == 'Game' or '$(ConfigurationType)' == 'DynamicLibrary'">
	<PostBuildEventUseInBuild>false</PostBuildEventUseInBuild>
  </PropertyGroup>

  <Target Name="BlitzkriegCopyDynamicLibraryToGameOutput"
		  AfterTargets="Build"
		  Condition="'$(ConfigurationType)' == 'DynamicLibrary' and Exists('$(TargetPath)')">
	<MakeDir Directories="$(BlitzkriegGameOutputDir)" />
	<Copy SourceFiles="$(TargetPath)"
		  DestinationFolder="$(BlitzkriegGameOutputDir)"
		  SkipUnchangedFiles="true" />
	<Copy SourceFiles="$(TargetDir)$(TargetName).pdb"
		  DestinationFiles="$(BlitzkriegGamePdbPath)"
		  SkipUnchangedFiles="true"
		  Condition="Exists('$(TargetDir)$(TargetName).pdb')" />
  </Target>

  <Target Name="BlitzkriegCopyExistingRuntimeToGameOutput"
		  AfterTargets="Build"
		  Condition="'$(MSBuildProjectName)' == 'Game'">
	<MakeDir Directories="$(BlitzkriegGameOutputDir)" />
	<Copy SourceFiles="@(BlitzkriegRuntimeDll)"
		  DestinationFolder="$(BlitzkriegGameOutputDir)"
		  SkipUnchangedFiles="true"
		  Condition="'@(BlitzkriegRuntimeDll)' != ''" />
	<Copy SourceFiles="@(BlitzkriegRuntimePdb)"
		  DestinationFolder="$(BlitzkriegGameOutputDir)"
		  SkipUnchangedFiles="true"
		  Condition="'@(BlitzkriegRuntimePdb)' != ''" />
  </Target>

  <PropertyGroup>
    <BlitzkriegMovieAssetsSourceDir>$(MSBuildThisFileDirectory)..\..\VideoAssets\Movies</BlitzkriegMovieAssetsSourceDir>
    <BlitzkriegMovieArchiveRootDir>$(MSBuildThisFileDirectory)..\..\VideoAssets</BlitzkriegMovieArchiveRootDir>
    <BlitzkriegMovieArchivePath Condition="Exists('$(BlitzkriegMovieArchiveRootDir)\BlitzkriegVideos.7z.001')">$(BlitzkriegMovieArchiveRootDir)\BlitzkriegVideos.7z.001</BlitzkriegMovieArchivePath>
    <BlitzkriegMovieArchivePath Condition="!Exists('$(BlitzkriegMovieArchivePath)') and Exists('$(BlitzkriegMovieArchiveRootDir)\BlitzkriegVideos.7z')">$(BlitzkriegMovieArchiveRootDir)\BlitzkriegVideos.7z</BlitzkriegMovieArchivePath>
    <BlitzkriegDataMoviesLink>$(BlitzkriegDataSourceDir)\Movies</BlitzkriegDataMoviesLink>
  </PropertyGroup>

  <Target Name="BlitzkriegExtractMovieAssets"
          AfterTargets="Build"
          Condition="'$(MSBuildProjectName)' == 'Game' and !Exists('$(BlitzkriegMovieAssetsSourceDir)') and Exists('$(BlitzkriegMovieArchivePath)')">
    <Message Text="Extracting movie assets from $(BlitzkriegMovieArchivePath) into VideoAssets\Movies" Importance="high" />
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(BlitzkriegMovieArchiveRootDir)\install_videos.ps1&quot; -ArchivePath &quot;$(BlitzkriegMovieArchivePath)&quot; -OutputPath &quot;$(BlitzkriegMovieAssetsSourceDir)&quot;"
          WorkingDirectory="$(BlitzkriegMovieArchiveRootDir)" />
  </Target>

  <Target Name="BlitzkriegEnsureDataLink"
          AfterTargets="Build"
          Condition="'$(MSBuildProjectName)' == 'Game' and Exists('$(BlitzkriegDataSourceDir)')">
    <Exec Command="cmd /c if exist &quot;Data&quot; if not exist &quot;Data\Cursor\1.xml&quot; rmdir &quot;Data&quot;"
          WorkingDirectory="$(BlitzkriegGameOutputDir)"
          ContinueOnError="WarnAndContinue" />
    <Exec Command="cmd /c if not exist &quot;Data&quot; mklink /D &quot;Data&quot; &quot;$(BlitzkriegDataRelativeSourceDir)&quot; || if not exist &quot;Data&quot; mklink /J &quot;Data&quot; &quot;$(BlitzkriegDataSourceDir)&quot;"
          WorkingDirectory="$(BlitzkriegGameOutputDir)"
          ContinueOnError="WarnAndContinue" />
  </Target>

  <Target Name="BlitzkriegEnsureDataMoviesLink"
		  DependsOnTargets="BlitzkriegExtractMovieAssets"
		  AfterTargets="BlitzkriegEnsureDataLink"
		  Condition="'$(MSBuildProjectName)' == 'Game' and Exists('$(BlitzkriegDataSourceDir)') and Exists('$(BlitzkriegMovieAssetsSourceDir)') and !Exists('$(BlitzkriegDataMoviesLink)')">
	<Message Text="Creating Data\Movies junction to VideoAssets\Movies" Importance="high" />
	<Exec Command="cmd /c mklink /J &quot;$(BlitzkriegDataMoviesLink)&quot; &quot;$(BlitzkriegMovieAssetsSourceDir)&quot;"
		  ContinueOnError="WarnAndContinue" />
  </Target>

</Project>
