<!-- The shutdown screen (InterfaceCloudShutdown.cpp): the credits backdrop -
     the main menu plate the credits roll over - with a three-line notice the
     code shows only while the exit-time cloud sync is running, and under it
     one button (3104) that skips the wait: it cancels the sync and the screen
     leaves when the main loop reports the settle. With nothing to wait for
     the screen leaves on its own and none of this is ever shown. -->
<base Background="1">
	<States>
		<item EventID="-1">
			<AppearanceNormal Color="0xffffffff" Specular="0xff000000" Depth="0.0001">
				<SubRects>
					<item>
						<rect x1="0" y1="0" x2="1024" y2="768"/>
						<map x1="0" y1="0" x2="1024" y2="768"/>
					</item>
				</SubRects>
				<Texture>ui\intermissiontextures\back-mainmenu</Texture>
			</AppearanceNormal>
			<AppearanceHighlighted Color="0xffffffff" Specular="0xff000000" Depth="0.0001">
				<SubRects>
					<item>
						<rect x1="0" y1="0" x2="1024" y2="768"/>
						<map x1="0" y1="0" x2="1024" y2="768"/>
					</item>
				</SubRects>
				<Texture>ui\intermissiontextures\back-mainmenu</Texture>
			</AppearanceHighlighted>
			<AppearancePushed Color="0xffffffff" Specular="0xff000000" Depth="0.0001">
				<SubRects>
					<item>
						<rect x1="0" y1="0" x2="1024" y2="768"/>
						<map x1="0" y1="0" x2="1024" y2="768"/>
					</item>
				</SubRects>
				<Texture>ui\intermissiontextures\back-mainmenu</Texture>
			</AppearancePushed>
		</item>
	</States>
	<!-- A button's click is a state-change notify that only the screen script
	     turns into an element message (CloudShutdown.lua), as MainMenu and
	     CloudBackups do; without it 3104 would never reach ProcessMessage. -->
	<Script>ui\CloudShutdown</Script>
	<Children>
		<item ClassTypeID="0x10001105" ElementID="3101" PositionFlag="0x0011" Background="0" ActiveFlag="0" VisibleFlag="0" TextAlign="0x0022" FontSize="2" TextColor="0xFFFDF2DB">
			<!--caption: syncing to the cloud; upper third of the screen so it reads over the backdrop-->
			<ShadowShift x="1" y="2"/>
			<TextPos x="0" y="0"/>
			<WindowPos x="0" y="120"/>
			<WindowSize x="1024" y="40"/>
			<States>
				<item>
					<PushSound/>
					<ClickSound/>
					<TextKey>Textes\UI\CloudShutdown\caption</TextKey>
				</item>
			</States>
		</item>
		<item ClassTypeID="0x10001105" ElementID="3102" PositionFlag="0x0011" Background="0" ActiveFlag="0" VisibleFlag="0" TextAlign="0x0022" FontSize="1" TextColor="0xffffbe34">
			<!--please wait-->
			<ShadowShift x="1" y="2"/>
			<TextPos x="0" y="0"/>
			<WindowPos x="0" y="174"/>
			<WindowSize x="1024" y="28"/>
			<States>
				<item>
					<PushSound/>
					<ClickSound/>
					<TextKey>Textes\UI\CloudShutdown\wait</TextKey>
				</item>
			</States>
		</item>
		<item ClassTypeID="0x10001105" ElementID="3103" PositionFlag="0x0011" Background="0" ActiveFlag="0" VisibleFlag="0" TextAlign="0x0022" FontSize="1" TextColor="0xffffbe34">
			<!--do not turn off-->
			<ShadowShift x="1" y="2"/>
			<TextPos x="0" y="0"/>
			<WindowPos x="0" y="204"/>
			<WindowSize x="1024" y="28"/>
			<States>
				<item>
					<PushSound/>
					<ClickSound/>
					<TextKey>Textes\UI\CloudShutdown\warning</TextKey>
				</item>
			</States>
		</item>
		<item ClassTypeID="0x10001103" ElementID="3104" PositionFlag="0x0011" TextAlign="0x0022" FontSize="1" VisibleFlag="0" ActiveFlag="1" TextColor="0xff000000">
			<!--skip and exit now: below the activity bar (y 252-262), centred like it-->
			<WindowPos x="352" y="284"/>
			<WindowSize x="320" y="49"/>
			<States>
				<item EventID="-1">
					<AppearanceNormal Color="0xffffffff" Specular="0xff000000" TextColor="0xff000000">
						<Maps x1="590" y1="957" x2="433" y2="66"/>
						<Texture>ui\IntermissionTextures\back-settings</Texture>
					</AppearanceNormal>
					<AppearanceHighlighted Color="0xffffffff" Specular="0xff000000" TextColor="0xff000000">
						<Maps x1="590" y1="888" x2="433" y2="66"/>
						<Texture>ui\IntermissionTextures\back-settings</Texture>
					</AppearanceHighlighted>
					<AppearancePushed Color="0xffffffff" Specular="0xff000000" TextColor="0xff000000">
						<Maps x1="590" y1="888" x2="433" y2="66"/>
						<Texture>ui\IntermissionTextures\back-settings</Texture>
					</AppearancePushed>
					<AppearanceDisabled Color="0xffffffff" Specular="0xff000000" TextColor="0xff777777">
						<Maps x1="590" y1="957" x2="433" y2="66"/>
						<Texture>ui\IntermissionTextures\back-settings</Texture>
					</AppearanceDisabled>
					<PushSound>sounds\buttons\select</PushSound>
					<ClickSound>sounds\buttons\ok</ClickSound>
					<TextKey>Textes\UI\CloudShutdown\skip</TextKey>
				</item>
			</States>
		</item>
	</Children>
</base>
