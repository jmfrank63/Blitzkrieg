<?xml version="1.0"?>
<!-- The Achtung Panzer 2 style of the constants the order hint is drawn from.
     The mod repainted its interface onto paper, but the hint is drawn by the
     scene rather than by a layout, so no restyle of the screens reaches it and
     it kept the amber-on-black of the game the mod was built on. Written on the
     parchment of its own unit card, in the black the rest of its paper uses,
     inside the dark brown its minimap is framed in - all three measured off a
     capture of the mod in a mission.
     The plate is two thirds opaque: the letters are black and lose nothing by
     it, and where the hint overhangs the paper strip along the bottom of the
     screen the battlefield shows through instead of a solid block. The frame
     stays opaque so the edge holds.
     Read over the mod's own consts.xml; see NMain::SetupModStyleConsts. -->
<base>
	<Scene>
		<Colors>
			<ToolTip>
				<Mission A="255" R="0" G="0" B="0"/>
				<InterMission A="255" R="0" G="0" B="0"/>
				<Current A="255" R="0" G="0" B="0"/>
				<Ground A="170" R="214" G="203" B="164"/>
				<Frame A="255" R="42" G="24" B="23"/>
			</ToolTip>
		</Colors>
	</Scene>
</base>
